# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "generic/debian12"
  config.vm.box_version = "4.3.12"

  config.vbguest.auto_update = false if Vagrant.has_plugin?("vagrant-vbguest")
  # use default private_key for vagrant user
  config.ssh.insert_key = false

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 1024
    vb.cpus = 2
    vb.gui = false
  end

  [15, 16, 17].each do |i|
    config.vm.define "valkey-node-#{i}" do |node|
      node.vm.hostname = "valkey-node-#{i}"
      node.vm.network "private_network", ip: "192.168.56.#{i}"
      node.vm.network "forwarded_port", guest: 6379, host: 6379 + (i - 15), host_ip: "127.0.0.1"

      node.vm.provider "virtualbox" do |vb|
        vb.name = "valkey-node-#{i}"
      end

      node.vm.provision "shell", inline: <<-SHELL
        apt-get update
        hostnamectl set-hostname valkey.node#{i}.local
      SHELL
    end
  end
end
